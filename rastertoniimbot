#!/usr/bin/python3 -I
# CUPS filter: CUPS raster -> NIIMBOT K3_W (ESC/POS "GS v 0" raster over the USB printer interface).
#
# Protocol, found by testing:
#   ESC @                      init
#   GS v 0 0 xL xH yL yH data  raster, always 80 bytes (640 dots) wide, bit 1 = black
#   FF ESC @                   end of label; the trailing ESC @ makes the printer start printing
# Labels are centred on the 80 mm print head; X_ADJUST_DOTS corrects the measured offset.
import os
import struct
import sys
import time

HEAD_DOTS = 640
HEAD_BYTES = HEAD_DOTS // 8
X_ADJUST_DOTS = 8          # +1 mm: test print was shifted ~1 mm left
DOTS_PER_MM = 8
# Within one stream the printer prints pages back to back and ignores the label gaps
# (FF and GS FF don't help); it only moves to the next label once it runs out of data.
# So each further page either waits PAGE_PAUSE seconds, or, with the LabelGap option
# set, follows the previous page after blank rows that cover the gap.
PAGE_PAUSE = 2.0
CS_K = 3                   # cupsColorSpace values where 1/255 means black
CS_W, CS_SW = 0, 18        # ... and where 0 means black
INVERT = bytes(range(255, -1, -1))
# Barcodes, QR codes and text are flat black (or dark grey) on white with sharp edges;
# photos and gradients have mid-tones that change smoothly. Areas where more than
# PHOTO_SHARE of the dots within PHOTO_R are smooth mid-tones seed a photo; it then
# spreads over smoothly changing dots up to the sharp edges around it, taking in its
# shadows and highlights. Photos get dithered, everything else a hard threshold
# (dithering a barcode makes its bars ragged and speckled).
MID_LO, MID_HI = 64, 224
PAPER = 250                # lighter dots are blank paper; photos don't spread over it
PHOTO_R = 3
PHOTO_SHARE = 0.5
EDGE_STEP = 64             # brightness change over 2 dots that marks an edge
PHOTO_GROW = 2             # then take in the photo's own fine detail
IS_MID = bytes(1 if MID_LO <= g < MID_HI else 0 for g in range(256))


def log(msg):
    sys.stderr.write(msg + "\n")
    sys.stderr.flush()


def read_exact(f, n):
    buf = f.read(n)
    if len(buf) != n:
        raise EOFError
    return buf


def read_header(f, endian):
    hdr = read_exact(f, 1796)
    u = lambda off: struct.unpack_from(endian + "I", hdr, off)[0]
    return {
        "page_pt": (u(352), u(356)),
        "width": u(372), "height": u(376), "bpc": u(384), "bpp": u(388),
        "bpl": u(392), "cs": u(400), "copies": u(340) or 1,
    }


def read_lines(f, h, compressed):
    """Yield h raw lines of h['bpl'] bytes each."""
    bpl, height = h["bpl"], h["height"]
    if not compressed:
        for _ in range(height):
            yield read_exact(f, bpl)
        return
    # CUPS raster v2 run-length compression
    unit = max(1, h["bpp"] // 8)
    blank = b"\xff" if h["cs"] in (CS_W, CS_SW) else b"\x00"
    y = 0
    while y < height:
        repeat = read_exact(f, 1)[0] + 1
        line = bytearray()
        while len(line) < bpl:
            n = read_exact(f, 1)[0]
            if n == 128:
                line += blank * (bpl - len(line))
            elif n < 128:
                line += read_exact(f, unit) * (n + 1)
            else:
                line += read_exact(f, (257 - n) * unit)
        line = bytes(line[:bpl])
        for _ in range(min(repeat, height - y)):
            yield line
            y += 1


def page_bits(lines, h):
    """Convert a page to ints whose set bits are black dots (MSB = leftmost)."""
    w = h["width"]
    if h["bpp"] == 1:
        full = (1 << w) - 1 if h["cs"] in (CS_W, CS_SW) else 0
        return [(int.from_bytes(line, "big") >> (len(line) * 8 - w)) ^ full for line in lines]
    if h["bpp"] != 8:
        raise ValueError("unsupported bits per pixel: %d" % h["bpp"])
    # grey levels with 0 = black
    grey = [line[:w] if h["cs"] in (CS_W, CS_SW) else line[:w].translate(INVERT)
            for line in lines]
    photo = photo_mask(grey, w)
    rows = []
    err = [0] * (w + 2)            # Floyd-Steinberg error for the current row, x+1 indexed
    for y, line in enumerate(grey):
        nxt = [0] * (w + 2)
        v = 0
        for x, g in enumerate(line):
            if photo[y][x]:
                g += err[x + 1] >> 4
                dot = g < 128
                e = g if dot else g - 255
                err[x + 2] += 7 * e
                nxt[x] += 3 * e
                nxt[x + 1] += 5 * e
                nxt[x + 2] += e
            else:
                dot = g < 128
            v = (v << 1) | dot
        rows.append(v)
        err = nxt
    return rows


def photo_mask(grey, w):
    """Per dot: 1 inside photos and gradients."""
    height = len(grey)
    if not any(any(line.translate(IS_MID)) for line in grey):
        return [bytes(w)] * height
    # smooth[y][x]: 1 where brightness changes slowly; edges and blank paper are 0
    smooth = []
    for y, line in enumerate(grey):
        up, down = grey[max(0, y - 1)], grey[min(height - 1, y + 1)]
        row = bytearray(w)
        for x, g in enumerate(line):
            if g < PAPER:
                dx = line[min(w - 1, x + 1)] - line[max(0, x - 1)]
                row[x] = abs(dx) + abs(down[x] - up[x]) < EDGE_STEP
        smooth.append(row)
    seeds = [bytes(a & b for a, b in zip(line.translate(IS_MID), s))
             for line, s in zip(grey, smooth)]
    mask = [bytearray(r) for r in box_count(seeds, w, PHOTO_R, PHOTO_SHARE * (2 * PHOTO_R + 1) ** 2)]
    # flood out from the seeds over smooth dots
    todo = [(x, y) for y, r in enumerate(mask) for x in range(w) if r[x]]
    while todo:
        x, y = todo.pop()
        for nx, ny in ((x - 1, y), (x + 1, y), (x, y - 1), (x, y + 1)):
            if 0 <= nx < w and 0 <= ny < height and smooth[ny][nx] and not mask[ny][nx]:
                mask[ny][nx] = 1
                todo.append((nx, ny))
    return box_count(mask, w, PHOTO_GROW, 0)


def box_count(marks, w, r, need):
    """Per dot: 1 where more than `need` of the 0/1 marks in the (2r+1)^2 square around it are set."""
    height = len(marks)
    cols = [0] * w                  # marks per column within rows y-r..y+r
    for m in marks[:r]:
        cols = [c + d for c, d in zip(cols, m)]
    out = []
    for y in range(height):
        if y + r < height:
            cols = [c + d for c, d in zip(cols, marks[y + r])]
        if y - r - 1 >= 0:
            cols = [c - d for c, d in zip(cols, marks[y - r - 1])]
        pre = [0]
        for c in cols:
            pre.append(pre[-1] + c)
        out.append(bytes(pre[min(w, x + r + 1)] - pre[max(0, x - r)] > need for x in range(w)))
    return out


def page_rows(lines, h, rotate, right_mm, up_mm):
    """Rows of the label as placed on the head (ints, HEAD_DOTS wide).
    right_mm / up_mm shift the image as the user sees the finished label."""
    w = h["width"]
    dx, dy = round(right_mm * DOTS_PER_MM), round(up_mm * DOTS_PER_MM)
    rows = page_bits(lines, h)
    if rotate:
        # 180 degrees: reverse row order and the dots within each row.
        # The label's bottom now prints first and its left side lies at the head's right.
        rows = [int(format(v, "0%db" % w)[::-1], 2) for v in reversed(rows)]
        dx, lead = -dx, dy
    else:
        lead = -dy
    offset = max(0, (HEAD_DOTS - w) // 2 + X_ADJUST_DOTS + dx)
    # lead > 0 delays the image by blank rows; lead < 0 drops leading rows
    rows = [0] * lead + rows if lead >= 0 else rows[-lead:]
    # place on the 640-dot head: shift right by offset, crop what falls off the head
    shift = HEAD_DOTS - offset - w
    full = (1 << HEAD_DOTS) - 1
    return [(v << shift if shift >= 0 else v >> -shift) & full for v in rows]


def to_esc(rows):
    out = b"".join(v.to_bytes(HEAD_BYTES, "big") for v in rows)
    return (b"\x1b@\x1dv0\x00" + struct.pack("<HH", HEAD_BYTES, len(rows))
            + out + b"\x0c\x1b@")


def ppd_lines():
    try:
        with open(os.environ["PPD"], encoding="latin-1") as ppd:
            return ppd.readlines()
    except (KeyError, OSError):
        return []


def ppd_default(keyword):
    """Printer-wide default from the queue's PPD (lpadmin -o writes it there)."""
    for line in ppd_lines():
        if line.startswith("*Default%s:" % keyword):
            return line.split(":", 1)[1].strip()
    return None


def label_shift(page_pt):
    """(right_mm, up_mm) of the labels.conf entry matching this page size, else (0, 0)."""
    best, best_d = (0.0, 0.0), 3.0          # tolerate rounding of the page size to points
    for line in ppd_lines():
        if not line.startswith("*NiimbotLabel "):
            continue
        try:
            w, h, right, up = map(float, line.split('"')[1].split())
        except (IndexError, ValueError):
            continue
        d = max(abs(w - page_pt[0]), abs(h - page_pt[1]))
        if d < best_d:
            best, best_d = (right, up), d
    return best


def mm_option(value):
    """PPD choice like "m1.5" / "p1" / "0" -> millimetres."""
    if not value:
        return 0.0
    sign = -1 if value[0] == "m" else 1
    try:
        return sign * float(value.lstrip("mp"))
    except ValueError:
        return 0.0


def main():
    f = open(sys.argv[6], "rb") if len(sys.argv) > 6 else sys.stdin.buffer
    sync = f.read(4)
    endian = {b"RaSt": ">", b"RaS2": ">", b"RaS3": ">",
              b"tSaR": "<", b"2SaR": "<", b"3SaR": "<"}.get(sync)
    if endian is None:
        log("ERROR: not a CUPS raster stream")
        return 1
    compressed = sync in (b"RaS2", b"2SaR")
    options = sys.argv[5].split() if len(sys.argv) > 5 else []
    opt = {k: ppd_default(k) for k in ("Rotate180", "ShiftRight", "ShiftUp", "LabelGap")}
    for o in options:
        k, _, v = o.partition("=")
        if k in opt:
            opt[k] = v
    rotate = opt["Rotate180"] != "False"
    right_mm, up_mm = mm_option(opt["ShiftRight"]), mm_option(opt["ShiftUp"])
    gap = mm_option(opt["LabelGap"]) if opt["LabelGap"] not in (None, "Pause") else None
    out = sys.stdout.buffer
    sent = [0, 0.0]                 # pages sent, time of the last one

    def send(data):
        if sent[0] and gap is None:
            time.sleep(max(0.0, PAGE_PAUSE - (time.monotonic() - sent[1])))
        out.write(data)
        out.flush()
        sent[0] += 1
        sent[1] = time.monotonic()
        log("PAGE: %d 1" % sent[0])

    def pages():
        """(rows, label height in rows) per page, in input order."""
        page = 0
        while True:
            try:
                h = read_header(f, endian)
            except EOFError:
                return
            page += 1
            lr, lu = label_shift(h["page_pt"])
            log("INFO: label %d (%dx%d dots), shift right %g mm, up %g mm"
                % (page, h["width"], h["height"], lr + right_mm, lu + up_mm))
            yield (page_rows(read_lines(f, h, compressed), h, rotate,
                             lr + right_mm, lu + up_mm), h["height"])

    # the whole tape is turned around, so with rotation the last page goes out first
    order = reversed(list(pages())) if rotate else pages()
    prev = None
    for cur in order:
        if prev:
            rows, height = prev
            if gap is not None:
                # blank rows up to the next label: label height + gap, whatever the shift did
                rows = rows + [0] * max(0, height + round(gap * DOTS_PER_MM) - len(rows))
            send(to_esc(rows))
        prev = cur
    if prev:
        send(to_esc(prev[0]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
